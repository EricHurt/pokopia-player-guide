---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import { gettingStartedArticle } from '../../data/copy/progression';

const article = gettingStartedArticle;
---

<BaseLayout frontmatter={{ title: article.title, description: article.description }}>
  <ArticleBody
    article={article}
    footerLinks={[
      { href: '/progression/early-game', label: 'Early game tips →' },
    ]}
  />
</BaseLayout>
