---
import '../styles/global.css';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
  /** Extra classes on `<body>` (e.g. forest theme). */
  bodyClass?: string;
  /** Extra classes on `<main>` (e.g. full width). */
  mainClass?: string;
}

const { frontmatter, bodyClass = '', mainClass = '' } = Astro.props;
const desc = frontmatter.description ?? '';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
/** PWA files exist only after `astro build` / production deploy (see `@vite-pwa/astro`). */
const pwaEnabled = import.meta.env.PROD;

const nav = [
  { href: '/', label: 'Home', match: (p: string) => p === '/' },
  {
    href: '/progression/getting-started',
    label: 'Progression',
    match: (p: string) => p.startsWith('/progression'),
  },
  {
    href: '/pokemon',
    label: 'Pokémon',
    match: (p: string) => p.startsWith('/pokemon'),
  },
  {
    href: '/habitats/basics',
    label: 'Habitats',
    match: (p: string) => p.startsWith('/habitats'),
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#2a8f5c" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Pokopia Guide" />
    <meta name="application-name" content="Pokopia Guide" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    {pwaEnabled ? <link rel="manifest" href="/manifest.webmanifest" /> : null}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{frontmatter.title} | Pokopia Guide</title>
    {pwaEnabled ? <script src="/registerSW.js" defer></script> : null}
  </head>
  <body class:list={['forest-site', bodyClass]}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/">Pokopia guide</a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map(({ href, label, match }) => (
                <li>
                  <a href={href} class:list={['nav-link', { active: match(path) }]}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class:list={['prose', mainClass]}>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Fan-made player guide · Not affiliated with any game publisher. Guides: <code>src/pages/</code> ·
        Typed game data: <code>src/data/</code> · Shared TypeScript: <code>src/types/</code>, <code
          >src/lib/</code
        >.
      </p>
    </footer>
  </body>
</html>
